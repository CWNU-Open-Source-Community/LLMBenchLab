# Local SQLite database. Relative paths are resolved from backend/ by the
# repository's Makefile and scripts. Alembic is the only runtime schema owner;
# run `make setup` or `make migrate` before starting the backend.
DATABASE_URL=sqlite:///./data/llmbenchlab.db

# Redis Streams is an optional low-latency notification layer for local
# development. Leave blank to let the independent Worker reconcile from the
# database only. Compose supplies an internal Redis URL in the Phase 2 stack.
REDIS_URL=
LLMBENCHLAB_WORKER_LEASE_SECONDS=30
LLMBENCHLAB_WORKER_HEARTBEAT_SECONDS=10
LLMBENCHLAB_WORKER_POLL_SECONDS=1
LLMBENCHLAB_REDIS_OPERATION_TIMEOUT_SECONDS=2

# Primary browser origin and the complete explicit CORS allowlist.
# CORS_ORIGINS takes precedence over FRONTEND_ORIGIN when both are present.
# Keep both localhost spellings because the README uses 127.0.0.1 while some
# developers open Vite through localhost. If the dev port changes, update the
# allowlist too. Wildcards are rejected.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development listeners.
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Example *environment variable name* stored with a provider configuration.
# This is not an API key and no corresponding secret is required for Mock runs.
DEMO_API_KEY_ENV=LLMBENCHLAB_DEMO_API_KEY

LOG_LEVEL=INFO
